# PayLight environment. Copy to .env (never commit it). Web and worker read the same variables.
# Values marked (secret) must only live in the hosting provider's env settings.

# ── Chain (X Layer mainnet; verified in docs/RESEARCH.md) ───────────────────
CHAIN_ID=196
RPC_URL=https://rpc.xlayer.tech          # or a dedicated provider URL (public RPC caps getLogs at 100 blocks)
RPC_URL_FALLBACK=https://xlayerrpc.okx.com
USDT0_ADDRESS=0x779Ded0c9e1022225f8E0630b35a9b54bE713736   # USD₮0, 6 decimals
GATEWAY_ADDRESS=                         # from deployments/196.json after Deploy.s.sol
CASHBACK_ROUTER_ADDRESS=
PROCESSOR_ADDRESS=                       # PayLight TapeOut processor (docs/MAINNET_LAUNCH.md)
CONFIRMATIONS=3                          # blocks before vending (D-07)
START_BLOCK=                             # gateway deployment block (worker backfills from here)

# ── Hot keys (secret; worker + web server only; never in the browser bundle) ──
OPERATOR_PRIVATE_KEY=                    # settles/refunds and relays gasless payments; holds only OKB gas
KEEPER_PRIVATE_KEY=                      # cashback distribute/top-up; holds only OKB
QUOTE_SIGNER_PRIVATE_KEY=                # signs quotes; holds nothing

# ── Bill provider ───────────────────────────────────────────────────────────
PROVIDER=vtpass                          # vtpass | mock
VTPASS_BASE_URL=https://sandbox.vtpass.com/api/   # live: https://vtpass.com/api/
VTPASS_API_KEY=                          # (secret)
VTPASS_PUBLIC_KEY=                       # (secret) PK_…
VTPASS_SECRET_KEY=                       # (secret) SK_…
DEFAULT_PHONE=08011111111                # used when the customer gives no phone

# ── App ─────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/paylight
SESSION_SECRET=                          # (secret) >= 32 random chars: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=                    # (secret) 32 bytes hex: openssl rand -hex 32 (AES-256-GCM for meter tokens)
ADMIN_BASIC_AUTH=                        # (secret) user:password for /admin
ADMIN_WALLETS=                           # comma-separated admin wallet addresses (SIWE)
QUOTE_TTL_SECONDS=120
MAX_ORDER_NGN=39000                      # keep below 30 USD₮0 (on-chain pilot cap) at the current rate
DAILY_WALLET_CAP_NGN=80000
FLOAT_MIN_NGN=5000                       # quotes pause when the VTpass float would drop below this
MIN_OPERATOR_OKB_WEI=5000000000000000    # 0.005 OKB

# ── Public wallets shown on /transparency (addresses only) ──────────────────
PUBLIC_DEPLOYER_ADDRESS=
PUBLIC_TREASURY_ADDRESS=
PUBLIC_OPERATOR_ADDRESS=
PUBLIC_KEEPER_ADDRESS=
PUBLIC_QUOTE_SIGNER_ADDRESS=
NEXT_PUBLIC_SUPPORT_TELEGRAM=https://t.me/

# ── Alerts ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=                      # (secret)
TELEGRAM_ALERT_CHAT_ID=
