{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm db:generate && pnpm --filter @paylight/web build",
    "watchPatterns": ["apps/web/**", "packages/shared/**", "packages/core/**", "packages/db/**", "pnpm-lock.yaml"]
  },
  "deploy": {
    "startCommand": "pnpm --filter @paylight/web start",
    "preDeployCommand": ["pnpm db:migrate"],
    "healthcheckPath": "/api/config",
    "restartPolicyType": "ON_FAILURE"
  }
}
