{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm db:generate",
    "watchPatterns": ["apps/worker/**", "packages/shared/**", "packages/core/**", "packages/db/**", "pnpm-lock.yaml"]
  },
  "deploy": {
    "startCommand": "pnpm --filter @paylight/worker start",
    "healthcheckPath": "/health",
    "restartPolicyType": "ALWAYS",
    "numReplicas": 1
  }
}
