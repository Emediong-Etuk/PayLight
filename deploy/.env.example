# Server env for deploy/docker-compose.yml. Copy to deploy/.env on the VPS (never commit it).
# Keep comments on their own lines: no "# ..." after a value.
# Values marked (secret) are private; fill them in on the server only.

# Your domain, or <server-ip-with-dashes>.sslip.io (e.g. 203-0-113-7.sslip.io) if you have none.
DOMAIN=
# openssl rand -hex 24
POSTGRES_PASSWORD=
# DATABASE_URL is set by docker-compose.yml from POSTGRES_PASSWORD.

# ── Chain (X Layer mainnet; verified in docs/RESEARCH.md) ───────────────────
CHAIN_ID=196
# Public RPC caps getLogs at 100 blocks; a dedicated provider URL also works.
RPC_URL=https://rpc.xlayer.tech
RPC_URL_FALLBACK=https://xlayerrpc.okx.com
# USD₮0, 6 decimals
USDT0_ADDRESS=0x779Ded0c9e1022225f8E0630b35a9b54bE713736
# From deployments/196.json after Deploy.s.sol (sent to you after the mainnet deploy)
GATEWAY_ADDRESS=
CASHBACK_ROUTER_ADDRESS=
# PayLight TapeOut processor (docs/MAINNET_LAUNCH.md)
PROCESSOR_ADDRESS=
# Blocks before vending (D-07)
CONFIRMATIONS=3
# Gateway deployment block (the worker backfills from here)
START_BLOCK=

# ── Hot keys (secret; never your deployment/admin wallet) ───────────────────
# (secret) settles/refunds and relays gasless payments; holds only OKB gas
OPERATOR_PRIVATE_KEY=
# (secret) cashback distribute/top-up; holds only OKB
KEEPER_PRIVATE_KEY=
# (secret) signs quotes; holds nothing
QUOTE_SIGNER_PRIVATE_KEY=

# ── Bill provider ───────────────────────────────────────────────────────────
# vtpass | mock
PROVIDER=vtpass
# Live: https://vtpass.com/api/
VTPASS_BASE_URL=https://sandbox.vtpass.com/api/
# (secret)
VTPASS_API_KEY=
# (secret) PK_…
VTPASS_PUBLIC_KEY=
# (secret) SK_…
VTPASS_SECRET_KEY=
# Used when the customer gives no phone
DEFAULT_PHONE=08011111111

# ── App ─────────────────────────────────────────────────────────────────────
# (secret) openssl rand -hex 32
SESSION_SECRET=
# (secret) openssl rand -hex 32; AES-256-GCM key for meter tokens. Back it up offline.
TOKEN_ENCRYPTION_KEY=
# (secret) user:password for /admin
ADMIN_BASIC_AUTH=
# Comma-separated admin wallet addresses (SIWE), lowercase
ADMIN_WALLETS=
QUOTE_TTL_SECONDS=120
# Keep below 30 USD₮0 (the on-chain pilot cap) at the current rate
MAX_ORDER_NGN=39000
DAILY_WALLET_CAP_NGN=80000
# Quotes pause when the VTpass float would drop below this
FLOAT_MIN_NGN=5000
# 0.005 OKB
MIN_OPERATOR_OKB_WEI=5000000000000000
NODE_ENV=production

# ── Public wallets shown on /transparency (addresses only) ──────────────────
PUBLIC_DEPLOYER_ADDRESS=
PUBLIC_TREASURY_ADDRESS=
PUBLIC_OPERATOR_ADDRESS=
PUBLIC_KEEPER_ADDRESS=
PUBLIC_QUOTE_SIGNER_ADDRESS=
# Baked into the web build; rebuild after changing it
NEXT_PUBLIC_SUPPORT_TELEGRAM=https://t.me/

# ── Alerts ──────────────────────────────────────────────────────────────────
# (secret) from @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
